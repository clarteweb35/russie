---
import '../styles/global.css';
import Badge from '../components/Badge.astro';
import { sections, LAST_CHECK, VERIFICATIONS, pagesLegales, NOM_SITE, url } from '../config';

interface ElementMenu { label: string; href: string; exact?: boolean }
interface ElementFil { label: string; href?: string }
interface Props {
  title: string;
  titreComplet?: string; // remplace « titre — marque » (page d'accueil)
  description?: string;
  marque?: string; // nom du guide dans le titre de l'onglet
  // Page d'un pays : bandeau de sécurité et sources propres au pays (alerte : situation exceptionnelle)
  pays?: { slug: string; nom: string; conseilsVoyageurs: string; test?: boolean; alerte?: boolean };
  menu?: ElementMenu[]; // menu propre à la page (sinon : menu de la Russie, ou aucun)
  fil?: ElementFil[]; // fil d'Ariane (le dernier élément est la page courante)
  jsonLd?: object[]; // données structurées supplémentaires
  image?: string; // image de partage (chemin sans préfixe de déploiement)
  noindex?: boolean;
  verifie?: string; // date de vérification propre à la page
  bandeau?: boolean; // false : aucun bandeau de sécurité
  meta?: boolean; // force l'affichage (ou non) de la ligne « Vérifié le … »
}
const { title, titreComplet, description = 'Guide d’information sur la Russie : voyager, vivre, travailler — avec sources officielles et mises en garde.', marque = 'Guide Russie', pays, menu, fil, jsonLd = [], image: cheminImage = '/saint-basile-hero.webp', noindex = false, verifie, bandeau = true, meta } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const isHome = path === '/';
// Pages de la Russie : leur menu est celui de la Russie
const estPageRussie = path === '/pays/russie' || sections.some((s) => path === s.href || path.startsWith(s.href + '/'));
const menuAffiche: ElementMenu[] = menu ?? (estPageRussie ? sections.map((s) => ({ label: s.label, href: s.href })) : isHome ? [{ label: 'Destinations', href: '/#destinations' }, { label: 'Russie', href: '/pays/russie' }] : []);
const actif = (m: ElementMenu) => m.href.includes('#') ? false : path === m.href || (!m.exact && path.startsWith(m.href + '/'));

const showMeta = meta ?? (!isHome && !['/sources', '/mentions-legales'].includes(path));
const dateVerif = verifie ?? VERIFICATIONS[path] ?? LAST_CHECK;
const lienSources = pays ? `/pays/${pays.slug}/sources` : '/sources';
const titreOnglet = titreComplet ?? `${title} — ${marque}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(url(cheminImage), Astro.site).href;
const accueil = new URL(url('/'), Astro.site).href;

// Fil d'Ariane : visible et déclaré aux moteurs de recherche
const filComplet: ElementFil[] | undefined = fil ? [{ label: 'Destinations', href: '/' }, ...fil] : undefined;
const donneesStructurees: object[] = [
  ...(filComplet ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: filComplet.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: e.label,
      item: e.href ? new URL(url(e.href), Astro.site).href : canonical,
    })),
  }] : []),
  ...(isHome ? [{ '@context': 'https://schema.org', '@type': 'WebSite', name: NOM_SITE, url: accueil, inLanguage: 'fr' }] : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b3202f" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={NOM_SITE} />
    <meta property="og:title" content={titreOnglet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {donneesStructurees.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{titreOnglet}</title>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <div id="progress"></div>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={url("/")} aria-label={`${NOM_SITE}, accueil`}><span class="nom">{NOM_SITE}</span></a>
        <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
        <nav id="menu" aria-label="Navigation principale">
          {!isHome && <a class="retour" href={url('/#destinations')}>← Toutes les destinations</a>}
          {menuAffiche.map((m) => (
            <a href={url(m.href)} aria-current={actif(m) ? 'page' : undefined}>{m.label}</a>
          ))}
        </nav>
      </div>
    </header>

    {pays && (
      <div class={pays.alerte ? 'banner banner-alerte' : 'banner banner-pays'} role="note">
        <div class="wrap">
          <span>{pays.test && <strong class="tag-test">Beta</strong>} {pays.alerte
            ? <><strong>Sécurité :</strong> situation exceptionnelle. Lisez la fiche officielle du ministère français avant toute décision.</>
            : <><strong>Avant de partir :</strong> consultez la fiche « {pays.nom} » des conseils aux voyageurs du ministère français.</>}</span>
          <a href={pays.conseilsVoyageurs} rel="noopener">Conseils aux voyageurs →</a>
        </div>
      </div>
    )}
    {!pays && bandeau && !isHome && estPageRussie && (
      <div class="banner" role="note">
        <div class="wrap">
          <span><strong>Sécurité :</strong> le ministère français déconseille tout déplacement en Russie.</span>
          <a href={url("/voyager#securite")}>Lire les conseils →</a>
        </div>
      </div>
    )}

    <main class="wrap" id="contenu">
      {filComplet && (
        <nav class="fil" aria-label="Fil d’Ariane">
          <ol>
            {filComplet.map((e, i) => (
              <li>{e.href && i < filComplet.length - 1 ? <a href={url(e.href)}>{e.label}</a> : <span aria-current="page">{e.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      {showMeta && (
        <p class="meta">
          <span>Vérifié le {dateVerif}</span>
          <Badge type="ok">Source officielle</Badge>
          <Badge type="warn">À confirmer</Badge>
          <a href={url(lienSources)}>Voir les sources</a>
        </p>
      )}
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p>Guide d’information indépendant, non officiel. Il ne remplace ni les sources officielles ni un avis juridique, médical ou fiscal.
        Les règles changent vite : vérifiez toujours auprès des autorités avant d’agir.</p>
        <p>Dernière vérification globale : {LAST_CHECK}. <a href={url("/sources")}>Voir les sources</a>. <a href={url("/#destinations")}>Toutes les destinations</a>.
        {pagesLegales.map((p) => (<> · <a href={url(p.href)}>{p.label}</a></>))}</p>
      </div>
    </footer>
    <script>
      const bar = document.getElementById('progress');
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        if (bar) bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const burger = document.getElementById('burger');
      const menu = document.getElementById('menu');
      const setMenu = (open: boolean) => {
        menu?.classList.toggle('open', open);
        burger?.setAttribute('aria-expanded', String(open));
        burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      };
      burger?.addEventListener('click', () => setMenu(!menu?.classList.contains('open')));
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

      const targets = document.querySelectorAll<HTMLElement>('main h2, main .lead, main table, main .card, main .step, main .callout');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      targets.forEach((el) => { el.classList.add('reveal'); io.observe(el); });
    </script>
  </body>
</html>
