---
import '../styles/global.css';
import Badge from '../components/Badge.astro';
import { sections, LAST_CHECK, VERIFICATIONS, pagesLegales, NOM_SITE, url } from '../config';
import { pays as listePays } from '../data/pays';
interface Props {
  title: string;
  description?: string;
  marque?: string; // nom du guide dans le titre de l'onglet
  pays?: { slug: string; nom: string; article: string; conseilsVoyageurs: string }; // page d'un guide pays : bandeau et sources propres au pays
  verifie?: string; // date de vérification propre à la page
  bandeau?: boolean; // false : aucun bandeau de sécurité
  meta?: boolean; // force l'affichage (ou non) de la ligne « Vérifié le … »
}
const { title, description = 'Guide d’information sur la Russie : voyager, vivre, travailler — avec sources officielles et mises en garde.', marque = 'Guide Russie', pays, verifie, bandeau = true, meta } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const isHome = path === '/';
const showMeta = meta ?? (!isHome && !['/sources', '/mentions-legales'].includes(path));
const dateVerif = verifie ?? VERIFICATIONS[path] ?? LAST_CHECK;
const lienSources = pays ? `/pays/${pays.slug}/sources` : '/sources';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(url('/saint-basile-hero.webp'), Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b3202f" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={marque} />
    <meta property="og:title" content={`${title} — ${marque}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title} — {marque}</title>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <div id="progress"></div>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={url("/")} aria-label={`${NOM_SITE}, accueil`}><span class="nom">{NOM_SITE.replace(".fr", "")}<b>.fr</b></span></a>
        <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
        <nav id="menu" aria-label="Navigation principale">
          {sections.map((l) => (
            <a href={url(l.href)} aria-current={path === l.href || path.startsWith(l.href + '/') ? 'page' : undefined}>{l.label}</a>
          ))}
          <div class="menu-pays">
            <a href={url('/pays')} aria-haspopup="true" aria-current={path === '/pays' || path.startsWith('/pays/') ? 'page' : undefined}>Autres pays <span aria-hidden="true">▾</span></a>
            <ul class="sous-menu">
              {listePays.map((p) => (
                <li>
                  {p.complet
                    ? <a href={url(`/pays/${p.slug}`)}>{p.nom}</a>
                    : <span class="bientot">{p.nom} <small>bientôt</small></span>}
                </li>
              ))}
            </ul>
          </div>
        </nav>
      </div>
    </header>

    {pays && (
      <div class="banner banner-pays" role="note">
        <div class="wrap">
          <span><strong>Avant de partir :</strong> consultez les conseils officiels du ministère français pour {pays.article}.</span>
          <a href={pays.conseilsVoyageurs} rel="noopener">Conseils aux voyageurs →</a>
        </div>
      </div>
    )}
    {!pays && bandeau && !isHome && (
      <div class="banner" role="note">
        <div class="wrap">
          <span><strong>Sécurité :</strong> le ministère français déconseille tout déplacement en Russie.</span>
          <a href={url("/voyager#securite")}>Lire les conseils →</a>
        </div>
      </div>
    )}

    <main class="wrap" id="contenu">
      {showMeta && (
        <p class="meta">
          <span>Vérifié le {dateVerif}</span>
          <Badge type="ok">Source officielle</Badge>
          <Badge type="warn">À confirmer</Badge>
          <a href={url(lienSources)}>Voir les sources</a>
        </p>
      )}
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p>Guide d’information indépendant, non officiel. Il ne remplace ni les sources officielles ni un avis juridique, médical ou fiscal.
        Les règles changent vite : vérifiez toujours auprès des autorités avant d’agir.</p>
        <p>Dernière vérification globale : {LAST_CHECK}. <a href={url("/sources")}>Voir les sources</a>.
        {pagesLegales.map((p) => (<> · <a href={url(p.href)}>{p.label}</a></>))}</p>
      </div>
    </footer>
    <script>
      const bar = document.getElementById('progress');
      const onScroll = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        if (bar) bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const burger = document.getElementById('burger');
      const menu = document.getElementById('menu');
      const setMenu = (open: boolean) => {
        menu?.classList.toggle('open', open);
        burger?.setAttribute('aria-expanded', String(open));
        burger?.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      };
      burger?.addEventListener('click', () => setMenu(!menu?.classList.contains('open')));
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });

      const targets = document.querySelectorAll<HTMLElement>('main h2, main .lead, main table, main .card, main .step, main .callout');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      targets.forEach((el) => { el.classList.add('reveal'); io.observe(el); });
    </script>
  </body>
</html>
