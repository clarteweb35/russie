---
// Page d'accueil : sélecteur de destination. Tous les pays du monde, par ordre alphabétique, avec recherche et filtre par région.
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { monde, groupesAlphabetiques, REGIONS, ALERTE_SECURITE, parIso } from '../data/monde';
import { offresDuPays } from '../data/offres-pays';
import { paysComplets } from '../data/pays';
import { NOM_SITE, url, legendeIA, A_LA_UNE } from '../config';

const groupes = groupesAlphabetiques();
const guides = monde.filter((p) => p.guide || p.iso === 'RUS');
const alaUne = A_LA_UNE.map((iso) => parIso(iso)).filter((p) => p !== undefined);
// Chiffres de l'accueil calculés depuis les données (jamais écrits en dur)
const nbLecons = paysComplets.filter((p) => p.lecons.length > 0).length + 1; // + la Russie, hors registre
const nbVilles = Object.keys(import.meta.glob('../data/villes/*.json')).length;
// Le même pays sert de fil conducteur : le plus riche du site (Finlande), avec sa première leçon
const exemple = paysComplets.find((p) => p.slug === 'finlande' && p.lecons.length > 0);
const lecon = exemple?.lecons[0];
const phrasesLecon = lecon ? lecon.phrases.slice(0, 3) : [];
const nbOffres = exemple ? (await offresDuPays(exemple.iso)).length : 0;
const vignettes = [
  { titre: 'Salutations', img: '/img/lecons/salutations.webp', alt: 'Une poignée de main entre deux personnes' },
  { titre: 'Se présenter', img: '/img/lecons/se-presenter.webp', alt: 'Un homme souriant présente sa carte de visite' },
  { titre: 'Se déplacer', img: '/img/lecons/se-deplacer-monde.webp', alt: 'Une table dans un compartiment de train avec une tasse, un carnet et un stylo' },
  { titre: 'Restaurant et courses', img: '/img/lecons/restaurant-courses-monde.webp', alt: 'Une table de restaurant dressée, avec des clients attablés' },
];
const sansAccent = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Pays du monde',
  numberOfItems: monde.length,
  itemListElement: monde.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.nom, url: new URL(url(p.href), Astro.site).href })),
}];
---
<Base
  title="Choisissez votre destination"
  titreComplet={`${NOM_SITE} : toutes les clés pour voyager, vivre et travailler à l’étranger`}
  description={`Choisissez votre destination parmi ${monde.length} pays : fiche d’identité, drapeau, monnaie et taux de change, conseils officiels, et guides détaillés avec leçons de langue.`}
  jsonLd={jsonLd}
  bandeau={false}
>
    <section class="accueil-hero">
    <img class="logo-hero" src={url('/img/logo-voyages-malins.webp')} alt="Voyages Malins : toutes les clés pour voyager" width="640" height="232" fetchpriority="high" />
    <h1>Tout pour préparer votre voyage, <em>au même endroit</em></h1>
    <p class="lead">Conseils officiels, guide détaillé, leçons audio dans la langue du pays, villes à connaître et bons plans : plus besoin de jongler entre dix sites. Choisissez un pays, tout y est.</p>

    <div class="recherche" role="search">
      <label for="recherche">Rechercher un pays ({monde.length} au choix)</label>
      <input id="recherche" type="search" placeholder="Ex. : Japon, Géorgie, Maroc…" autocomplete="off" aria-controls="resultats" />
      <!-- Suggestions : remplies par le script au fil de la frappe, directement sous le champ -->
      <ul id="resultats" class="liste-pays resultats" aria-label="Pays correspondants" hidden></ul>
      <div class="filtres" role="group" aria-label="Filtrer par région">
        <button type="button" class="filtre actif" data-region="">Toutes les régions</button>
        {REGIONS.map((r) => <button type="button" class="filtre" data-region={r}>{r}</button>)}
      </div>
      <p id="compte" class="src" aria-live="polite"></p>
    </div>
  </section>

  <section id="tout-au-meme-endroit" aria-labelledby="tout-titre">
    <h2 id="tout-titre">Tout au même endroit, pour chaque voyage</h2>
    <ul class="atouts">
      <li><span class="ico" aria-hidden="true">⚡</span><div><h3>L’essentiel en une page</h3><p>Entrée, sécurité, santé, argent, urgences : l’indispensable en quelques lignes, tiré des fiches du ministère des Affaires étrangères.</p></div></li>
      <li><span class="ico" aria-hidden="true">🧭</span><div><h3>Des guides détaillés</h3><p>Voyager, vivre, travailler, payer sur place, avec les sources et un badge « vérifié » ou « à confirmer ». {guides.length} pays déjà.</p></div></li>
      <li><span class="ico" aria-hidden="true">🎧</span><div><h3>Des leçons pour parler</h3><p>Les phrases utiles dans la langue du pays : vous écoutez, vous répétez, vous vous entraînez avec un quiz. {nbLecons} pays déjà.</p></div></li>
      <li><span class="ico" aria-hidden="true">📍</span><div><h3>Les villes à connaître</h3><p>Trois idées de villes ou de sites par pays, avec les sources consultées. {nbVilles} pays.</p></div></li>
      <li><span class="ico" aria-hidden="true">🏷️</span><div><h3>Bons plans et astuces</h3><p>Des offres retenues seulement si le prix est vraiment bas, et des astuces pour voyager moins cher. <a href={url('/bons-plans')}>Bons plans</a> · <a href={url('/guides')}>Astuces</a></p></div></li>
      <li class="a-venir"><span class="ico" aria-hidden="true">✈️</span><div><h3>Comparer les vols <Badge type="warn">À venir</Badge></h3><p>Choisissez votre ville de départ et vos dates, puis trouvez des options pour rejoindre votre destination. Ce service n’est pas encore disponible.</p></div></li>
    </ul>
  </section>

  {exemple && lecon && (
    <section id="parcours" aria-labelledby="parcours-titre">
      <h2 id="parcours-titre">Un seul endroit pour préparer votre voyage</h2>
      <p>Prenons {exemple.article} : voici comment les contenus se complètent, de la première leçon au départ.</p>
      <ol class="parcours-liste">
        <li>
          <a href={url(`/pays/${exemple.slug}/lecons/${lecon.slug}`)}>
            <span class="num">1</span>
            <strong>J’apprends</strong>
            <span class="txt">Une leçon audio avec quiz, par exemple « {lecon.titre} » : {phrasesLecon.map(([mot, , fr]) => `${mot} (${fr.split(' / ')[0].toLowerCase()})`).join(', ')}.</span>
          </a>
        </li>
        <li>
          <a href={url(`/pays/${exemple.slug}/essentiel`)}>
            <span class="num">2</span>
            <strong>Je prépare</strong>
            <span class="txt">L’essentiel du pays en une page : entrée, sécurité, santé, argent et urgences, d’après les fiches du ministère.</span>
          </a>
        </li>
        <li>
          <a href={url(`/pays/${exemple.slug}`)}>
            <span class="num">3</span>
            <strong>Je choisis</strong>
            <span class="txt">Le guide détaillé : voyager, vivre, payer sur place et villes à connaître, avec les sources citées.</span>
          </a>
        </li>
        <li>
          <a href={url('/bons-plans')}>
            <span class="num">4</span>
            <strong>Je pars</strong>
            <span class="txt">{nbOffres > 0 ? `${nbOffres} offre${nbOffres > 1 ? 's' : ''} repérée${nbOffres > 1 ? 's' : ''} vers ${exemple.article}.` : 'Les bons plans : une offre n’est publiée que si son prix est vraiment bas, donc il n’y en a pas toujours.'}</span>
          </a>
        </li>
      </ol>
      <p class="src">{nbLecons} pays ont des leçons audio, {nbVilles} ont leur page « villes à connaître ».</p>
      <ul class="vignettes-lecons">
        {vignettes.map((v) => (
          <li><a href={url(`/pays/${exemple.slug}/lecons`)}><img src={url(v.img)} alt={legendeIA(v.alt)} title={legendeIA(v.alt)} width="320" height="190" loading="lazy" /><span>{v.titre}</span></a></li>
        ))}
      </ul>
    </section>
  )}

  <section id="guides" aria-labelledby="guides-titre">
    <h2 id="guides-titre">Des pays à la une</h2>
    <p>Les guides les plus complets du site. Les fiches « beta » n’ont pas encore été relues.</p>
    <ul class="guides-grille">
      {alaUne.map((p) => (
        <li>
          <a href={url(p.href)}>
            <img src={url(`/drapeaux/${p.iso.toLowerCase()}.svg`)} alt="" width="48" height="32" loading="lazy" />
            <span><strong>{p.nom}</strong><small>{p.iso === 'RUS' || ALERTE_SECURITE.has(p.iso) ? 'Voyage déconseillé' : p.guide?.test ? 'Beta' : 'Guide relu'}</small></span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="#destinations">Voir les {monde.length} pays, de A à Z →</a></p>
  </section>

  <section id="destinations" aria-labelledby="destinations-titre">
    <h2 id="destinations-titre">Tous les pays, de A à Z</h2>
    <nav class="alphabet" aria-label="Aller à une lettre">
      {groupes.map((g) => <a href={`#lettre-${g.lettre}`}>{g.lettre}</a>)}
    </nav>

    <div id="liste">
      {groupes.map((g) => (
        <section class="groupe" id={`lettre-${g.lettre}`} aria-label={`Pays commençant par ${g.lettre}`}>
          <h3>{g.lettre}</h3>
          <ul class="liste-pays">
            {g.pays.map((p) => (
              <li data-n={sansAccent(p.nom)} data-nom={sansAccent(`${p.nom} ${p.nomOfficiel} ${p.capitales.join(' ')}`)} data-region={p.region}>
                <a href={url(p.href)}>
                  <img src={url(`/drapeaux/${p.iso.toLowerCase()}.svg`)} alt="" width="36" height="24" loading="lazy" />
                  <span class="nom">{p.nom}{p.guide && <small class="tag-guide">{p.guide.test ? 'beta' : 'guide'}</small>}{p.iso === 'RUS' && <small class="tag-guide">guide</small>}</span>
                  <span class="det">{p.capitales[0] ? `${p.capitales[0]} · ` : ''}{p.sousRegion || p.region}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p id="aucun" class="src" hidden>Aucun pays ne correspond à votre recherche.</p>
  </section>

  <p class="src">Ce site est indépendant et non officiel. Pour chaque pays, les conseils aux voyageurs du ministère de l’Europe et des Affaires étrangères restent la référence. <a href={url('/mentions-legales')}>Mentions légales</a>.</p>
</Base>

<script>
  const champ = document.getElementById('recherche') as HTMLInputElement | null;
  const boutons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtre'));
  const elements = Array.from(document.querySelectorAll<HTMLLIElement>('#liste li'));
  const groupes = Array.from(document.querySelectorAll<HTMLElement>('#liste .groupe'));
  const compte = document.getElementById('compte');
  const aucun = document.getElementById('aucun');
  let region = '';

  const sansAccent = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  const panneau = document.getElementById('resultats') as HTMLUListElement | null;
  const mots = (s: string) => s.split(/[\s'’-]+/);

  // Suggestions progressives : « a » donne les pays en A, « al » Albanie, Algérie, Allemagne…
  // Rang 0 : le nom commence par la saisie ; 1 : un mot du nom commence par la saisie (dès 2 lettres) ;
  // 2 : la saisie figure dans le nom officiel ou la capitale (dès 3 lettres), pour ne pas noyer les premières lettres.
  function suggerer(q: string) {
    if (!panneau) return;
    panneau.replaceChildren();
    if (!q) { panneau.hidden = true; return; }
    const trouves: { li: HTMLLIElement; rang: number }[] = [];
    elements.forEach((li) => {
      if (region && li.dataset.region !== region) return;
      const n = li.dataset.n ?? '';
      let rang = -1;
      if (n.startsWith(q)) rang = 0;
      else if (q.length >= 2 && mots(n).some((m) => m.startsWith(q))) rang = 1;
      else if (q.length >= 3 && (li.dataset.nom ?? '').includes(q)) rang = 2;
      if (rang >= 0) trouves.push({ li, rang });
    });
    trouves.sort((a, b) => a.rang - b.rang); // tri stable : l'ordre alphabétique est conservé dans chaque rang
    trouves.forEach(({ li }) => {
      const a = li.querySelector('a');
      if (!a) return;
      const item = document.createElement('li');
      item.append(a.cloneNode(true));
      panneau.append(item);
    });
    panneau.hidden = trouves.length === 0;
  }

  function filtrer() {
    const q = sansAccent(champ?.value ?? '');
    suggerer(q);
    let n = 0;
    elements.forEach((li) => {
      const ok = (!q || (li.dataset.nom ?? '').includes(q)) && (!region || li.dataset.region === region);
      li.hidden = !ok;
      if (ok) n++;
    });
    groupes.forEach((g) => { g.hidden = !g.querySelector('li:not([hidden])'); });
    if (compte) compte.textContent = q || region ? `${n} pays trouvé${n > 1 ? 's' : ''}.` : '';
    if (aucun) aucun.hidden = n > 0;
  }

  champ?.addEventListener('input', filtrer);

  // Clavier : Entrée ouvre le premier résultat, ↓ descend dans la liste, ↑ remonte, Échap revient au champ
  const liens = () => Array.from(panneau?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
  champ?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); liens()[0]?.focus(); }
    else if (e.key === 'Enter') { const premier = liens()[0]; if (premier) { e.preventDefault(); premier.click(); } }
    else if (e.key === 'Escape' && champ.value) { champ.value = ''; filtrer(); }
  });
  panneau?.addEventListener('keydown', (e) => {
    const tous = liens();
    const i = tous.indexOf(document.activeElement as HTMLAnchorElement);
    if (e.key === 'ArrowDown') { e.preventDefault(); tous[Math.min(i + 1, tous.length - 1)]?.focus(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); if (i <= 0) champ?.focus(); else tous[i - 1].focus(); }
    else if (e.key === 'Escape') champ?.focus();
  });
  boutons.forEach((b) => b.addEventListener('click', () => {
    region = b.dataset.region ?? '';
    boutons.forEach((x) => x.classList.toggle('actif', x === b));
    filtrer();
  }));
</script>
