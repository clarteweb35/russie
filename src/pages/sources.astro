---
// Sources et méthode du site : page générale. Les sources détaillées de chaque pays sont sur sa propre page « Sources ».
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { paysComplets } from '../data/pays';
import { LAST_CHECK, NOM_SITE, url } from '../config';

const liste = [{ nom: 'Russie', href: '/pays/russie/sources' }, ...paysComplets.map((p) => ({ nom: p.nom, href: `/pays/${p.slug}/sources` }))]
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
---
<Base
  title="Sources et méthode"
  titreComplet={`Sources et méthode : d’où viennent les informations | ${NOM_SITE}`}
  description="D’où viennent les informations de Voyages Malins : conseils officiels du ministère, données ouvertes, résumés générés par IA signalés, et sources détaillées de chaque pays."
  fil={[{ label: 'Sources' }]}
  meta={false}
  bandeau={false}
>
  <h1>Sources et méthode</h1>
  <p class="lead">Voyages Malins est un site indépendant. Il ne remplace pas les conseils officiels : pour chaque pays, la référence reste la fiche du ministère de l’Europe et des Affaires étrangères. Dernière vérification globale : {LAST_CHECK}.</p>

  <h2>Comment lire les badges</h2>
  <ul>
    <li><Badge type="ok">Vérifié</Badge> : appuyé par une source officielle ou un document cité.</li>
    <li><Badge type="warn">À confirmer</Badge> : information de seconde main, chiffre variable ou non recoupé. À vérifier auprès d’une source officielle avant de décider.</li>
    <li><strong>À documenter</strong> : nous n’avons pas encore de source fiable ; nous préférons l’écrire plutôt que d’inventer.</li>
  </ul>

  <h2>Nos sources</h2>
  <ul>
    <li><strong>Conseils officiels :</strong> les fiches « conseils aux voyageurs » et « informations par pays » de <a href="https://www.diplomatie.gouv.fr/" rel="noopener">France Diplomatie</a> (sécurité, entrée, santé, contacts), importées dans le site puis mises à jour régulièrement.</li>
    <li><strong>Fiche d’identité des pays :</strong> jeu de données ouvert « countries » (GitHub), base de fuseaux horaires IANA, Banque mondiale (population), Wikidata (capitales).</li>
    <li><strong>Taux de change :</strong> convertisseur interrogé depuis votre navigateur (Banque de Russie pour le rouble, taux de référence de la Banque centrale européenne, ExchangeRate-API en secours).</li>
    <li><strong>Outil « Quand partir ? » :</strong> Eurostat (fréquentation et prix de l’hébergement) et NASA POWER (climat). Chaque donnée est affichée avec sa source et sa date sur <a href={url('/outils/quand-partir')}>la page de l’outil</a>.</li>
    <li><strong>Guides détaillés :</strong> chaque pays a sa page « Sources », avec les liens consultés. Les sources commerciales (blogs, sites de voyage) y sont signalées comme telles.</li>
  </ul>

  <h2>Contenus générés par intelligence artificielle</h2>
  <p>Deux blocs sont des résumés générés par IA, toujours signalés comme tels : « L’actu de la semaine » et « Les villes à connaître ». Ils peuvent contenir des erreurs et ne sont ni un conseil de voyage ni une source officielle. Les villes sont tirées de sites de voyage, pas de sources officielles. Détails dans les <a href={url('/mentions-legales')}>mentions légales</a>.</p>

  <h2>Sources pays par pays</h2>
  <ul class="liens-sources">
    {liste.map((p) => <li><a href={url(p.href)}>{p.nom}</a></li>)}
  </ul>

  <p class="src">Ce site est indépendant et n’a aucun lien avec une administration. Il ne constitue ni un conseil juridique, ni fiscal, ni médical.</p>
</Base>
