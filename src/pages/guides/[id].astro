---
import { url } from "../../config";
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  meta={false}
  fil={[{ label: "Astuces & hacks voyage", href: "/guides/" }, { label: guide.data.title }]}
>

    <a class="back-link" href={url("/guides/")}>← Tous les guides</a>

    <article class="guide-article">
      {
        guide.data.image && (
          <div class="guide-article__media">
            <img src={url(guide.data.image)} alt={guide.data.title} />
          </div>
        )
      }
      <div class="guide-article__body">
        <h1>{guide.data.title}</h1>
        <Content />
      </div>
    </article>
</Base>
