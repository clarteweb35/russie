---
import Base from '../../../layouts/Base.astro';
import Alert from '../../../components/Alert.astro';
import Actualites from '../../../components/Actualites.astro';
import { paysComplets } from '../../../data/pays';
import { url, leNomDeLangue, deNomDeLangue } from '../../../config';

export function getStaticPaths() {
  return paysComplets.map((p) => ({ params: { pays: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const base = `/pays/${p.slug}`;
---
<Base title={`Guide ${p.nom}`} marque={`Guide ${p.nom}`} pays={p} verifie={p.verifie} meta={false}>
  <section class="hero-pays" style={`--c1:${p.couleur}`}>
    <span class="eyebrow">Guide indépendant · mis à jour le {p.verifie}</span>
    <h1>Préparer {p.article}</h1>
    <p>{p.accroche}</p>
    <div class="cta">
      <a class="btn" href={url(`${base}/voyager`)}>Voyager →</a>
      <a class="btn-line" href={url(`${base}/lecons`)}>🎧 Apprendre {leNomDeLangue(p.langue.nom)}</a>
    </div>
  </section>

  <h2>Explorer</h2>
  <div class="grid">
    {p.rubriques.map((r) => (
      <a class="card" href={url(`${base}/${r.slug}`)}>
        <div class="ico">{r.icone}</div>
        <h3>{r.titre}</h3>
        <p>{r.resume}</p>
        <span class="more">Ouvrir →</span>
      </a>
    ))}
    <a class="card" href={url(`${base}/lecons`)}>
      <div class="ico">🎧</div>
      <h3>Leçons {deNomDeLangue(p.langue.nom)}</h3>
      <p>{p.lecons.length} leçons courtes avec audio et quiz d’écoute.</p>
      <span class="more">Ouvrir →</span>
    </a>
    <a class="card" href={url(`${base}/sources`)}>
      <div class="ico">📚</div>
      <h3>Sources</h3>
      <p>D’où viennent les informations et leur fiabilité.</p>
      <span class="more">Ouvrir →</span>
    </a>
  </div>

  <Actualites slug={p.slug} libelle={p.article} medias={p.mediasLocaux} officiel={{ texte: `Conseils aux voyageurs du ministère français pour ${p.article}`, url: p.conseilsVoyageurs }} />

  {p.test && (
    <Alert titre="Fiche en test" warn>
      Cette fiche a été construite à partir de recherches rapides, pour la plupart sur des sources non officielles. Elle n’a pas été relue : <strong>vérifiez chaque point sur la fiche officielle du ministère</strong> avant de décider. Les leçons de langue sont à faire relire par un locuteur.
    </Alert>
  )}

  {!p.test && (
  <Alert titre="Guide en cours de rédaction" warn>
    Plusieurs sections sont marquées « À confirmer » ou « À documenter » : elles reposent sur des sources non officielles ou restent à compléter. Vérifiez toujours auprès des autorités avant d’agir.
  </Alert>
  )}
</Base>
