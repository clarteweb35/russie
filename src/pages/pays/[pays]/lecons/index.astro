---
import Base from '../../../../layouts/Base.astro';
import ListeLecons from '../../../../components/ListeLecons.astro';
import { deNomDeLangue } from '../../../../config';
import { paysComplets } from '../../../../data/pays';
import { parIso, contextePays } from '../../../../data/monde';


export function getStaticPaths() {
  return paysComplets.filter((p) => p.lecons.length > 0).map((p) => ({ params: { pays: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const ctx = contextePays(parIso(p.iso)!);
---
<Base title={`Leçons ${deNomDeLangue(p.langue.nom)}`} marque={`Guide ${p.nom}`} {...ctx} fil={[{ label: p.nom, href: `/pays/${p.slug}` }, { label: 'Leçons' }]} verifie={p.verifie}>
  <h1>Leçons {deNomDeLangue(p.langue.nom)} essentielles</h1>
  <p class="lead">{p.lecons.length} leçons courtes : vous écoutez, vous répétez, vous vous entraînez avec un quiz.</p>
  <ListeLecons lecons={p.lecons} base={`/pays/${p.slug}/lecons`} langue={p.langue} couleur={p.couleur} />
</Base>
