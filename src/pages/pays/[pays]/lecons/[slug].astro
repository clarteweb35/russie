---
import LeconDetail from '../../../../components/LeconDetail.astro';
import { paysComplets } from '../../../../data/pays';
import { parIso, contextePays } from '../../../../data/monde';


export function getStaticPaths() {
  return paysComplets.flatMap((p) =>
    p.lecons.map((l, i) => ({
      params: { pays: p.slug, slug: l.slug },
      props: { p, lecon: l, index: i, prev: p.lecons[i - 1], next: p.lecons[i + 1] },
    })),
  );
}
const { p, lecon, index, prev, next } = Astro.props;
const ctx = contextePays(parIso(p.iso)!);
---
<LeconDetail lecon={lecon} index={index} prev={prev} next={next} langue={p.langue} base={`/pays/${p.slug}/lecons`} marque={`Guide ${p.nom}`} pays={ctx.pays} menu={ctx.menu} fil={[{ label: p.nom, href: `/pays/${p.slug}` }, { label: 'Leçons', href: `/pays/${p.slug}/lecons` }, { label: lecon.titre }]} verifie={p.verifie} />
