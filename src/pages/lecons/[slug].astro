---
import LeconDetail from '../../components/LeconDetail.astro';
import { lecons } from '../../data/lecons';

export function getStaticPaths() {
  return lecons.map((l, i) => ({
    params: { slug: l.slug },
    props: { lecon: l, index: i, prev: lecons[i - 1], next: lecons[i + 1] },
  }));
}
const { lecon, index, prev, next } = Astro.props;
---
<LeconDetail lecon={lecon} index={index} prev={prev} next={next} langue={{ nom: 'russe', code: 'ru-RU' }} base="/lecons" fil={[{ label: 'Russie', href: '/pays/russie' }, { label: 'Leçons de russe', href: '/lecons' }, { label: lecon.titre }]} />
