---
import { url } from "../../config";
import Base from "../../layouts/Base.astro";
import { mention } from "../../data/partenaires";
import { getCollection, render } from "astro:content";
import { paysDeOffre } from "../../data/offres-pays";

export async function getStaticPaths() {
  const bonsPlans = await getCollection("bons-plans");
  return bonsPlans.map((offre) => ({
    params: { id: offre.id },
    props: { offre },
  }));
}

const { offre } = Astro.props;
const { Content } = await render(offre);
const pays = paysDeOffre(offre);

const labelConfiance: Record<string, string> = {
  ELEVE: "Bon plan confirmé",
  MOYEN: "Offre repérée",
  FAIBLE: "À vérifier avant réservation",
};
---

<Base
  title={offre.data.title}
  description={offre.data.description}
  meta={false}
  fil={[{ label: "Bons plans", href: "/bons-plans/" }, { label: offre.data.title }]}
>

    <a class="back-link" href={url("/bons-plans/")}>&larr; Retour au tableau des départs</a>
    {pays && <a class="back-link" href={url(`${pays.href}/`)}>Voir la fiche pays : {pays.nom} (monnaie, conseils officiels) &rarr;</a>}

    <article class="ticket-article">
      {
        offre.data.image && (
          <div class="ticket-article__media">
            <img src={url(offre.data.image)} alt={offre.data.destination ?? offre.data.title} />
          </div>
        )
      }
      <div class={`ticket-article__stub ${offre.data.image ? "" : "no-media"}`}>
        <span class="ticket-article__confidence">
          {labelConfiance[offre.data.confidence] ?? offre.data.confidence}
        </span>
        <h1>{offre.data.title}</h1>
      </div>
      <div class="ticket-article__perforation"></div>
      <div class="ticket-article__body">
        <Content />
        {
          (offre.data.avisPourquoi || offre.data.avisAttention) && (
            <div class="avis-malin">
              <p class="avis-malin__title">🧭 L'avis du Malin</p>
              {offre.data.avisPourquoi && (
                <div class="avis-malin__row">
                  <span class="avis-malin__label">Pourquoi</span>
                  <span>{offre.data.avisPourquoi}</span>
                </div>
              )}
              {offre.data.avisAttention && (
                <div class="avis-malin__row">
                  <span class="avis-malin__label">Attention</span>
                  <span>{offre.data.avisAttention}</span>
                </div>
              )}
            </div>
          )
        }
        {
          offre.data.lien && (
            <p>
              <a class="pays-teaser__cta" href={offre.data.lien} target="_blank" rel="sponsored noopener">
                Voir l'offre{offre.data.voyagiste ? ` chez ${offre.data.voyagiste}` : ""} →
              </a>
            </p>
          )
        }
      </div>
    </article>
    {offre.data.lien && <p class="src">{mention}</p>}
</Base>
