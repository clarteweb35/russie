---
// Drapeau russe qui flotte : tranches verticales décalées dans le temps (animation CSS, coupée si mouvement réduit).
const N = 9;
const LARGEUR = 4;
const X0 = 4;
const tranches = Array.from({ length: N }, (_, i) => X0 + i * LARGEUR);
---
<svg class="drapeau" viewBox="0 0 42 30" role="img" aria-label="Drapeau de la Russie" focusable="false">
  <rect x="1.4" y="2" width="1.6" height="27" rx=".8" fill="#8a8794" />
  <circle cx="2.2" cy="2" r="1.4" fill="#e8a33d" />
  {tranches.map((x, i) => (
    <g class="tranche" style={`--i:${i}`}>
      <rect x={x} y="5" width={LARGEUR + 0.4} height="6.7" fill="#ffffff" />
      <rect x={x} y="11.7" width={LARGEUR + 0.4} height="6.7" fill="#0039a6" />
      <rect x={x} y="18.4" width={LARGEUR + 0.4} height="6.7" fill="#d52b1e" />
      <rect class="ombre" x={x} y="5" width={LARGEUR + 0.4} height="20.1" fill="#000" />
    </g>
  ))}
  <rect x="4" y="5" width="36" height="20.1" fill="none" stroke="rgba(0,0,0,.18)" stroke-width=".4" class="cadre" />
</svg>
