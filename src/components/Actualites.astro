---
// Topo hebdomadaire généré par IA (scripts/actualites.mjs). Rien ne s'affiche tant qu'aucun topo n'a été généré.
import Badge from './Badge.astro';
import Alert from './Alert.astro';

interface Topo {
  slug: string;
  genere: string;
  modele: string;
  resume: string;
  points: { titre: string; texte: string }[];
  sources: { titre: string; url: string }[];
}
interface Props { slug: string; libelle: string; officiel?: { texte: string; url: string } }
const { slug, libelle, officiel } = Astro.props;

const fichiers = import.meta.glob<Topo>('../data/actualites/*.json', { eager: true, import: 'default' });
const topo = Object.entries(fichiers).find(([chemin]) => chemin.endsWith(`/${slug}.json`))?.[1];
const date = topo ? new Date(topo.genere).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
{topo && (
  <section class="actu" aria-labelledby={`actu-${slug}`}>
    <h2 id={`actu-${slug}`}>L’actu de la semaine <Badge type="warn">Résumé généré par IA</Badge></h2>
    <p class="src">Pour {libelle}, généré le {date} avec {topo.modele} à partir d’une recherche web. Peut contenir des erreurs : consultez les sources.</p>
    <p>{topo.resume}</p>
    {topo.points.length > 0 && (
      <ul>
        {topo.points.map((p) => <li><strong>{p.titre}</strong> : {p.texte}</li>)}
      </ul>
    )}
    <p class="src">
      Sources :{' '}
      {topo.sources.map((s, i) => <>{i > 0 && ' ; '}<a href={s.url} rel="noopener">{s.titre}</a></>)}
    </p>
    {officiel && (
      <Alert titre="Ce résumé n’est pas un conseil de voyage" warn>
        <a href={officiel.url} rel="noopener">{officiel.texte}</a>
      </Alert>
    )}
  </section>
)}
