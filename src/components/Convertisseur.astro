---
// Convertisseur euro ⇄ monnaie locale. Par défaut le rouble (comportement historique des pages russes).
// Sources : Banque de Russie pour le rouble ; taux de référence de la Banque centrale européenne (Frankfurter) sinon ;
// ExchangeRate-API en secours. Délai de 5 s par service, dernier taux connu mémorisé dans le navigateur.
interface Props { code?: string; nom?: string; symbole?: string }
const { code = 'RUB', nom = 'rouble', symbole = '₽' } = Astro.props;
const nomMaj = nom.charAt(0).toUpperCase() + nom.slice(1);
const idTitre = `fx-title-${code.toLowerCase()}`;
---
<section class="fx" aria-labelledby={idTitre} data-code={code} data-symbole={symbole}>
  <div class="fx-head">
    <h3 id={idTitre}>Convertisseur EUR ⇄ {code}</h3>
    <button class="fx-swap" type="button" aria-label="Inverser le sens de conversion">⇄</button>
  </div>
  <div class="fx-row">
    <label>
      <span>Euros</span>
      <input class="fx-eur" type="text" inputmode="decimal" value="100" autocomplete="off" />
      <b>€</b>
    </label>
    <label>
      <span>{nomMaj}</span>
      <input class="fx-loc" type="text" inputmode="decimal" autocomplete="off" />
      <b>{symbole}</b>
    </label>
  </div>
  <p class="fx-info" aria-live="polite">Chargement du taux…</p>
</section>

<script>
  const fmt = (n: number, d = 2) => n.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });
  const parse = (s: string) => parseFloat(s.replace(/\s/g, '').replace(',', '.'));

  type Taux = { rate: number; date: string; source: string; enCache?: boolean };

  // Appel réseau avec délai maximum, pour ne pas attendre indéfiniment un service en panne
  const getJson = async (adresse: string, delai = 5000) => {
    const ctrl = new AbortController();
    const minuteur = setTimeout(() => ctrl.abort(), delai);
    try {
      const r = await fetch(adresse, { signal: ctrl.signal });
      if (!r.ok) throw new Error(String(r.status));
      return await r.json();
    } finally {
      clearTimeout(minuteur);
    }
  };

  // Le stockage local peut être indisponible (navigation privée) : on ignore l'erreur
  const cle = (code: string) => `taux-eur-${code.toLowerCase()}`;
  const lireCache = (code: string): Taux | null => {
    try { const c = JSON.parse(localStorage.getItem(cle(code)) || 'null'); return c?.rate ? { ...c, enCache: true } : null; } catch { return null; }
  };
  const ecrireCache = (code: string, t: Taux) => { try { localStorage.setItem(cle(code), JSON.stringify(t)); } catch { /* sans importance */ } };

  async function chargerTaux(code: string): Promise<Taux> {
    if (code === 'RUB') {
      try {
        const j = await getJson('https://www.cbr-xml-daily.ru/daily_json.js');
        const v = j.Valute.EUR;
        return { rate: v.Value / v.Nominal, date: j.Date, source: 'de la Banque de Russie' };
      } catch { /* repli ci-dessous */ }
    } else {
      try {
        const j = await getJson(`https://api.frankfurter.dev/v1/latest?base=EUR&symbols=${code}`);
        if (j.rates?.[code]) return { rate: j.rates[code], date: j.date, source: 'de référence de la Banque centrale européenne' };
      } catch { /* repli ci-dessous */ }
    }
    const j = await getJson('https://open.er-api.com/v6/latest/EUR');
    if (!j.rates?.[code]) throw new Error('devise inconnue');
    return { rate: j.rates[code], date: new Date(j.time_last_update_unix * 1000).toISOString(), source: 'ExchangeRate-API' };
  }

  // Un seul appel par devise et par page ; si tout échoue, on affiche le dernier taux connu (signalé comme tel)
  const promesses = new Map<string, Promise<Taux>>();
  const taux = (code: string) => {
    if (!promesses.has(code)) {
      promesses.set(code, chargerTaux(code).then((t) => { ecrireCache(code, t); return t; }).catch(() => {
        const cache = lireCache(code);
        if (cache) return cache;
        throw new Error('aucun taux');
      }));
    }
    return promesses.get(code)!;
  };

  document.querySelectorAll<HTMLElement>('.fx').forEach((box) => {
    const code = box.dataset.code || 'RUB';
    const symbole = box.dataset.symbole || '';
    const eur = box.querySelector<HTMLInputElement>('.fx-eur')!;
    const loc = box.querySelector<HTMLInputElement>('.fx-loc')!;
    const info = box.querySelector<HTMLElement>('.fx-info')!;
    const swap = box.querySelector<HTMLButtonElement>('.fx-swap')!;
    let rate = 0;

    const depuisEur = () => { const v = parse(eur.value); loc.value = isFinite(v) && rate ? fmt(v * rate) : ''; };
    const depuisLoc = () => { const v = parse(loc.value); eur.value = isFinite(v) && rate ? fmt(v / rate) : ''; };
    eur.addEventListener('input', depuisEur);
    loc.addEventListener('input', depuisLoc);
    swap.addEventListener('click', () => {
      const e = eur.value; eur.value = loc.value; loc.value = e;
      depuisEur();
    });

    taux(code).then((d) => {
      rate = d.rate;
      // Un taux très petit ou très grand garde des décimales utiles
      const decimales = rate < 1 ? 4 : rate < 100 ? 2 : 0;
      const date = new Date(d.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
      const prefixe = d.enCache ? 'Dernier taux connu (services indisponibles) :' : 'Taux';
      info.textContent = `1 € = ${fmt(rate, decimales)} ${symbole} · ${prefixe} ${d.source} du ${date}. Indicatif : les banques et bureaux de change appliquent leur propre taux.`;
      depuisEur();
    }).catch(() => {
      info.textContent = code === 'RUB'
        ? 'Taux indisponible pour le moment. Vérifiez le taux sur le site de la Banque de Russie.'
        : 'Taux indisponible pour le moment. Vérifiez le taux auprès de votre banque.';
    });
  });
</script>
