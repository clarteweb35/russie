---
import { url } from "../config";
// Pied de page commun des pages de Voyages Malins.
import { mention } from '../data/partenaires';
interface Props { affilie?: boolean } // true : la page contient des liens affiliés
const { affilie = false } = Astro.props;
---
<footer class="vm-footer">
  {affilie && <p class="vm-footer__affil">{mention}</p>}
  <p>
    Voyages Malins · <a href={url("/guides/")}>Astuces &amp; Hacks Voyage</a> · <a href={url("/#destinations")}>Pays</a> · <a href={url("/mentions-legales")}>Mentions légales</a>
  </p>
</footer>
<style>
  .vm-footer {
    margin: 3rem auto 0;
    padding: 1.5rem 1.25rem 2.5rem;
    max-width: 960px;
    border-top: 1px solid var(--line, rgba(22, 35, 63, 0.18));
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    text-align: center;
  }
  .vm-footer p { margin: 0.3rem 0; }
  .vm-footer__affil { opacity: 0.8; }
</style>
